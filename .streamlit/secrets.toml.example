# Streamlit Cloud → App → Settings → Secrets ішіне көшіріңіз (GitHub-қа ЕШҚАШАН жүктемеңіз!)

# --- Бас әкімші ---
ADMIN_USERNAME = "Aidar"
ADMIN_PASSWORD = "бұнда_құпиясөз"
ADMIN_EMAIL = "admin@example.kz"

# --- Supabase (PostgreSQL). Project → Connect → Session pooler URI ---
DATABASE_URL = "postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Электрондық мұрағат: GitHub (жеке репо, мыс. aidarpavl/school-docs-2026-2027) ---
GITHUB_TOKEN = "github_pat_..."          # fine-grained: тек осы репоға Contents: Read and write
GITHUB_DOCS_REPO = "aidarpavl/school-docs-{year}"   # {year} → 2026-2027 автоматты
GITHUB_DOCS_BRANCH = "main"

# --- Құпиясөзді поштамен қалпына келтіру (Gmail: 2FA + App password) ---
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465
SMTP_USER = "mektep.platform@gmail.com"
SMTP_PASSWORD = "16 таңбалы app password"

# --- Міндетті емес: ЖИ ұсыныстары ---
# ANTHROPIC_API_KEY = "sk-ant-..."
